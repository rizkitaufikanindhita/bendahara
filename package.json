{
  "name": "bendahara-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.mjs",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check scripts/import-sqlite.mjs",
    "build": "npm run check",
    "import:sqlite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1"
  }
}
